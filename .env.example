# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Banco ---
# Runtime do app: usuario SEM superuser (app_user), para o RLS funcionar.
DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:5432/barbearia
# Migrations: usuario dono do banco.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barbearia

# --- Auth ---
# Gere com: openssl rand -base64 48  (minimo 32 caracteres)
AUTH_SECRET=

# --- Pagamento (Semana 6) ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=

# --- E-mail (Semana 7) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Operacao (Semana 7) ---
SENTRY_DSN=
CRON_SECRET=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
